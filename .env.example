# Environment variables for advertisinganalyticsdashboard.
# The project is deployed on Vercel — all real values live in the Vercel
# project (Settings → Environment Variables). After cloning, restore with:
#   vercel link && vercel env pull .env.local
# POSTGRES_*/PG*/DATABASE_URL come from the Neon integration; KV_*/REDIS_URL
# from Vercel KV/Upstash; VERCEL_OIDC_TOKEN is auto-generated by env pull.
# OAuth/ads credentials come from each platform's developer console
# (Google Cloud Console, Meta for Developers, Microsoft Entra / Ads).

NODE_ENV=development
NEXTAUTH_SECRET=

# OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Ads platform API access
GOOGLE_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_PRIVATE_KEY_ID=

# Scraping / email
BROWSERLESS_API_KEY=
BROWSERLESS_API_URL=
EMAIL_PASSWORD=

# Neon / Vercel Postgres (provided by the integration via `vercel env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGDATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGPASSWORD=
PGUSER=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# Vercel KV / Redis (provided by the integration)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=

# Auto-generated by `vercel env pull`; do not set manually
VERCEL_OIDC_TOKEN=
